<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: #E3F2FD;" stylesheets="@Style.css"
      xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.ReservaSalaController">

    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Reservar Sala" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0D47A1;">
        <font>
            <Font name="Arial" size="24"/>
        </font>
        <effect>
            <DropShadow color="#90CAF9" radius="3"/>
        </effect>
    </Label>

    <!-- Fecha y Hora de Inicio -->
    <DatePicker fx:id="fechaInicioPicker" promptText="Fecha de Inicio" prefWidth="300" />
    <TextField fx:id="horaInicioField" promptText="Hora de Inicio (HH:mm)" prefWidth="300" />

    <!-- Fecha y Hora de Fin -->
    <DatePicker fx:id="fechaFinPicker" promptText="Fecha de Fin" prefWidth="300" />
    <TextField fx:id="horaFinField" promptText="Hora de Fin (HH:mm)" prefWidth="300" />

    <!-- Detalle del recurso -->
    <TextArea fx:id="detalleRecursoArea" promptText="¿Por qué necesitas la sala?" prefWidth="300" prefHeight="100"
        style="-fx-background-color: white; -fx-border-color: #BBDEFB; -fx-border-radius: 6;" wrapText="true"/>

    <!-- Tabla de Salas -->
    <TableView fx:id="salaTable" prefHeight="200" prefWidth="700" style="-fx-background-color: white; -fx-border-color: #BBDEFB;">
        <columns>
            <TableColumn fx:id="idSalaColumn" text="ID Sala" prefWidth="80"/>
            <TableColumn fx:id="nombreSalaColumn" text="Nombre" prefWidth="120"/>
            <TableColumn fx:id="capacidadColumn" text="Capacidad" prefWidth="90"/>
            <TableColumn fx:id="softwareDisponibleColumn" text="Software" prefWidth="120"/>
            <TableColumn fx:id="hardwareEspecialColumn" text="Hardware" prefWidth="120"/>
            <TableColumn fx:id="ubicacionColumn" text="Ubicación" prefWidth="100"/>
            <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="70"/>
        </columns>
    </TableView>

    <!-- Botón para Reservar -->
    <Button fx:id="btnReservar" text="Reservar Sala" onAction="#reservarSala"
        prefWidth="300" style="-fx-font-size: 16; -fx-background-color: #64B5F6; -fx-text-fill: white;" />

    <!-- Botón para volver -->
    <!-- <Button fx:id="btnVolver" text="Volver" onAction="#volver" prefWidth="300" style="-fx-font-size: 16;"/> -->

</VBox>