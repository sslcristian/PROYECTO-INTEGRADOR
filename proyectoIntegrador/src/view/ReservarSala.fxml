<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" spacing="20" style="-fx-background-color: #E3F2FD;" stylesheets="@Style.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.ReservarSalaController">
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label text="Reservar Sala de Informática" style="-fx-font-size: 24; -fx-font-weight: bold; -fx-text-fill: #0D47A1;">
        <font>
            <Font name="Arial" size="24"/>
        </font>
        <effect>
            <DropShadow color="#90CAF9" radius="3"/>
        </effect>
    </Label>

    
    <DatePicker fx:id="fechaInicioPicker" promptText="Fecha de Inicio" prefWidth="300" />
    <TextField fx:id="horaInicioField" promptText="Hora de Inicio (HH:mm)" prefWidth="300" />

  
    <DatePicker fx:id="fechaFinPicker" promptText="Fecha de Fin" prefWidth="300" />
    <TextField fx:id="horaFinField" promptText="Hora de Fin (HH:mm)" prefWidth="300" />

   
    <TextArea fx:id="detalleRecursoArea" promptText="¿Por qué necesitas la sala?" prefWidth="300" prefHeight="100"
              style="-fx-background-color: white; -fx-border-color: #BBDEFB; -fx-border-radius: 6;" wrapText="true"/>

  
    <TableView fx:id="salaTable" prefHeight="200" prefWidth="750" style="-fx-background-color: white; -fx-border-color: #BBDEFB;">
        <columns>
            <TableColumn fx:id="idSalaColumn" text="ID" prefWidth="50"/>
            <TableColumn fx:id="nombreSalaColumn" text="Nombre" prefWidth="120"/>
            <TableColumn fx:id="capacidadColumn" text="Capacidad" prefWidth="80"/>
            <TableColumn fx:id="softwareColumn" text="Software" prefWidth="120"/>
            <TableColumn fx:id="hardwareColumn" text="Hardware" prefWidth="120"/>
            <TableColumn fx:id="ubicacionColumn" text="Ubicación" prefWidth="100"/>
            <TableColumn fx:id="estadoColumn" text="Estado" prefWidth="100"/>
        </columns>
    </TableView>

   
    <Button fx:id="btnReservar" text="Reservar Sala" onAction="#reservarSala"
            prefWidth="300" style="-fx-font-size: 16; -fx-background-color: #64B5F6; -fx-text-fill: white;" />

    
</VBox>
