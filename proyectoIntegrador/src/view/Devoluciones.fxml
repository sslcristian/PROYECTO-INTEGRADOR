<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="600.0" prefWidth="800.0" spacing="20" style="-fx-background-color: #F3F6FB;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.DevolucionController">

    <padding>
        <Insets bottom="20" left="30" right="30" top="20" />
    </padding>

 
    <Label alignment="CENTER" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #2466a3;" text="Registro de Devoluciones" />

 
    <VBox spacing="15">
        <ComboBox fx:id="comboSolicitud" prefWidth="400" promptText="Seleccione una solicitud " />
        <DatePicker fx:id="fechaDevolucion" prefWidth="400" promptText="Fecha de devolución" />
        <TextField fx:id="horaDevolucion" prefWidth="400" promptText="Hora de devolución (HH:mm)" />
        <TextField fx:id="estadoRecurso" prefWidth="400" promptText="Estado del recurso" />
        <TextArea fx:id="observaciones" prefHeight="100" prefWidth="400" promptText="Observaciones" wrapText="true" />
    </VBox>


    <HBox alignment="CENTER" spacing="15">
        <Button fx:id="btnRegistrar" onAction="#registrarDevolucion" styleClass="btn-primary" text="➕ Registrar Devolución" />
      <Button fx:id="btnEliminar" onAction="#EliminarDevolucion" styleClass="btn-primary" text="➕ Eliminar Devolución" />
        <Button fx:id="btnVolver" onAction="#volverAlMenu" styleClass="btn-secondary" text="🔙 Volver al Menú" />
    </HBox>

  
    <TableView fx:id="tablaDevoluciones" prefHeight="250" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colIdSolicitud" prefWidth="100" text="ID Solicitud" />
            <TableColumn fx:id="colFechaDevolucion" prefWidth="150" text="Fecha Devolución" />
            <TableColumn fx:id="colHoraDevolucion" prefWidth="150" text="Hora Devolución" />
            <TableColumn fx:id="colEstado" prefWidth="150" text="Estado Recurso" />
            <TableColumn fx:id="colObservaciones" prefWidth="250" text="Observaciones" />
        </columns>
    </TableView>
   <stylesheets>
      <URL value="@styles.css" />
      <URL value="@Style.css" />
   </stylesheets>

</VBox>
