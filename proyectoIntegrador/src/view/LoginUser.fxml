<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="400" prefWidth="400" spacing="10" style="-fx-background-color: #E3F2FD;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controller.LoginUserController">

    <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="INICIO DE SESIÓN USUARIO" />

    <TextField fx:id="txtCedula" promptText="Cédula" />
    <PasswordField fx:id="txtContrasena" promptText="Contraseña" />

    <Button onAction="#iniciarSesion" text="Iniciar Sesión" />
</VBox>
